@{
    var editorValue =
        "<h2><img src='https://js.devexpress.com/jQuery/Demos/WidgetsGallery/JSDemos/images/widgets/HtmlEditor.svg' alt='HtmlEditor'> Formatted Text Editor</h2>" +
        "<br><p>DevExtreme JavaScript HTML Editor is a client-side WYSIWYG text editor.</p>" +
        "<iframe src='https://www.youtube.com/embed/ZwKhufmMxko'></iframe>";
}

@await Html.PartialAsync("_EmojiPopup")
@await Html.PartialAsync("_VideoPopup")
@await Html.PartialAsync("_LinkPopup")
@await Html.PartialAsync("_MarkupPopup")

@(Html.DevExtreme().HtmlEditor()
    .ID("html-editor")
    .Value(editorValue)
    .CustomizeModules("onCustomizeModules")
    .OnInitialized("onEditorInitialized")
    .Toolbar(toolbar => toolbar.Items(items => {
        items.Add().Name("undo");
        items.Add().Name("redo");
        items.Add().Name("separator");
        
        items.Add().Name("header")
            .AcceptedValues(new JS("[false, 1, 2, 3, 4, 5]"));
            
        items.Add().Name("separator");
        items.Add().Name("bold");
        items.Add().Name("italic");
        items.Add().Name("strike");
        items.Add().Name("underline");
        items.Add().Name("separator");
        items.Add().Name("alignLeft");
        items.Add().Name("alignCenter");
        items.Add().Name("alignRight");
        items.Add().Name("alignJustify");
        items.Add().Name("separator");

        items.Add().Widget(w => w.Button()
            .Icon("link")
            .Hint("Insert Custom Link")
            .StylingMode(ButtonStylingMode.Text)
            .OnClick("onLinkClick")
        );

        items.Add().Widget(w => w.Button()
            .Text("😀")
            .Hint("Insert Emoji")
            .FocusStateEnabled(false)
            .StylingMode(ButtonStylingMode.Text)
            .OnClick("onEmojiClick")
        );

        items.Add().Widget(w => w.Button()
            .Icon("video")
            .Hint("Insert/Edit Video")
            .StylingMode(ButtonStylingMode.Text)
            .OnClick("onVideoClick")
        );

        items.Add().Widget(w => w.Button()
            .Text("Show markup")
            .StylingMode(ButtonStylingMode.Text)
            .OnClick("onMarkupClick")
        );
    }))
)

@section Scripts {
    <script src="~/js/helpers/VideoPopupHelper.js"></script>
    <script src="~/js/helpers/EmojiPopupHelper.js"></script>
    <script src="~/js/helpers/LinkPopupHelper.js"></script>
    <script>
        const ctx = {};

        function onCustomizeModules(config) {
            VideoPopupHelper.setupClipboard(config);
        }

        function onEditorInitialized(e) {
            const editor = e.component;
            VideoPopupHelper.registerBlot(editor);
            ctx.editor = editor;
            ctx.emojiHelper = new EmojiPopupHelper(editor);
            ctx.videoHelper = new VideoPopupHelper(editor);
            ctx.linkHelper = new LinkPopupHelper(editor);
        }

        function onLinkClick() {
            const range = ctx.editor.getSelection();
            const index = range ? range.index : ctx.editor.getLength();
            const length = range ? range.length : 0;
            ctx.linkHelper.show(index, length);
        }

        function onEmojiClick(e) {
            const range = ctx.editor.getSelection();
            const index = range ? range.index : ctx.editor.getLength();
            ctx.emojiHelper.show(index, e.element);
        }

        function onVideoClick() {
            const range = ctx.editor.getSelection();
            const index = range ? range.index : ctx.editor.getLength();
            const length = range ? range.length : 0;
            ctx.videoHelper.show(index, length);
        }

        function onMarkupClick() {
            const markupPopup = $("#markup-popup").dxPopup("instance");
            markupPopup.show();
        }

        function onMarkupShowing() {
            $(".value-content").text(ctx.editor.option("value"));
        }
    </script>
}
